---
// Shown after a quote request is saved. Wording is new and needs the owner's approval.
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Request sent | Wedding Lighting Co" noindex closing={false} quoteBar={false} section="/get-a-quote">
  <header class="ph nf">
    <h1>We got your request</h1>
    <p class="lede">Thank you. We will get right back to you.</p>
    <div class="actions"><a class="btn" href="/">Home</a><a class="btn" href="/venue">Pictures</a><a class="btn" href={`tel:${site.phone}`}>{site.phone}</a></div>
  </header>
</Base>
