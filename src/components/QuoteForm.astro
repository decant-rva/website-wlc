---
// Fields and labels match the form on the previous site.
---
<form class="quote" action="/api/quote" method="post" enctype="multipart/form-data">
  <p><label for="q-name">Full Name</label><input id="q-name" name="name" autocomplete="name" required></p>
  <p><label for="q-date">Event Date</label><input id="q-date" name="eventDate" type="date"></p>
  <p><label for="q-ref">How did you find us?</label><input id="q-ref" name="howDidYouFindUs"></p>
  <p><label for="q-email">Email</label><input id="q-email" name="email" type="email" autocomplete="email" required></p>
  <p><label for="q-venue">Where's your event?</label><input id="q-venue" name="venue"></p>
  <p><label for="q-vision">Tell us about your vision</label><textarea id="q-vision" name="details" rows="6"></textarea></p>
  <p><label for="q-files">Photos or inspiration (optional)</label><input id="q-files" name="files" type="file" multiple accept="image/*,application/pdf"></p>
  <p class="trap" aria-hidden="true"><label for="q-company">Company</label><input id="q-company" name="company" tabindex="-1" autocomplete="off"></p>
  <p><button type="submit">Submit</button></p>
</form>
