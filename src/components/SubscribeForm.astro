---
// Email sign-up. Posts to /api/subscribe, which confirms by email before adding anyone.
---
<form class="quote subscribe" action="/api/subscribe" method="post">
  <p><label for="s-email">Email</label><input id="s-email" name="email" type="email" autocomplete="email" required></p>
  <p class="trap" aria-hidden="true"><label for="s-extra">Leave this empty</label><input id="s-extra" name="qz_extra" tabindex="-1" autocomplete="off"></p>
  <p><button class="btn solid" type="submit">Subscribe</button></p>
</form>
